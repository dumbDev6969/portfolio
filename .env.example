# Frontend
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Serverless API (api/chat.ts) — set these in Vercel Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

# Required in production: your deployed Vercel URL (no trailing slash)
CHAT_ALLOWED_ORIGIN=https://your-project.vercel.app

# Optional: Vercel KV (Upstash Redis) for rate limiting
# Automatically set when you link a KV store in the Vercel dashboard
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: rate limit tuning (defaults: 5 requests per 3600 seconds)
# CHAT_RATE_LIMIT_MAX=5
# CHAT_RATE_LIMIT_WINDOW_SECONDS=3600
